# Installed by SteamFrameDongleFix (steam-frame-dongle).
# Steam Frame wireless adapter (28de:2432, rtw89_8852cu): turn off rtw89
# inactive power save each time the interface appears. systemd-run keeps the
# udev worker free while debugfs for the new phy appears.
ACTION=="add", SUBSYSTEM=="net", ATTRS{idVendor}=="28de", ATTRS{idProduct}=="2432", RUN+="/usr/bin/systemd-run --no-block --quiet /usr/local/bin/steam-frame-dongle udev-apply $name"
